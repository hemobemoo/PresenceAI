# Copy to .env (never commit .env). Fill values; leave unused ones empty.

# --- Needed from day 1 ---
OPENROUTER_API_KEY=          # OpenRouter key named "presenceai-app"
# Model ids come from configs/models.yaml (llm.openrouter: pinned + fallbacks), chosen in
# spike S4 (ADR 0003). The two lines below are OPTIONAL overrides; leave them empty to use the
# config. Example values (the S4 choice): see configs/models.yaml.
OPENROUTER_MODEL=            # optional override of the pinned free model id (ends in :free)
OPENROUTER_FALLBACK_MODELS=  # optional override, comma-separated, e.g. org/a:free,org/b:free
MEDIA_KEY=                   # Fernet key; generate once (see setup guide step 8.2); back it up
HF_TOKEN=                    # Hugging Face READ token "presenceai-read"
PRESENCEAI_HOME=             # optional; default ~/.presenceai

# --- Needed later (leave empty now) ---
HF_TOKEN_WRITE=              # P4: push trained models (fine-grained write token)
KAGGLE_API_TOKEN=            # P4: Kaggle CLI (or use ~/.kaggle/access_token)
SUPABASE_URL=                # P7 Stage B only
SUPABASE_KEY=                # P7 Stage B only (service key stays server-side)

# ---Goes into the shell environment---
CONTEXT7_API_KEY=
GITHUB_PAT=
